# Copy to .env for local testing (`npm run dev`). On Netlify, set these under
# Site configuration → Environment variables. Never commit real values.

# PayPal: developer.paypal.com → Apps & Credentials. Use the Sandbox app to test, then Live.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Supabase: Project Settings → API. The service role key is secret — server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Password volunteers type on /admin. Make it long; change it each year.
ADMIN_PASSWORD=

# Optional: confirmation emails. Leave blank to rely on PayPal's receipt only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
